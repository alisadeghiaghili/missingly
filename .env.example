APP_HOST=0.0.0.0
APP_PORT=8090
APP_ENV=local
SECRET_KEY=replace-with-at-least-32-random-characters
# Bearer tokens are stored as hashes server-side and expire after this many days.
SESSION_TTL_DAYS=14
ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
TRUST_PROXY_HEADERS=false

# For local browser usage keep localhost. For real Zarinpal callbacks use a public URL,
# for example an ngrok URL: https://your-id.ngrok-free.app
PUBLIC_BASE_URL=http://localhost:8090

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=replace-with-mailbox-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=ThinkFlow
CONTACT_RECIPIENT_EMAIL=noreply@example.com
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
MAIL_TRANSPORT=auto

DATABASE_NAME=users.db
# PostgreSQL is required when APP_ENV=production. The application creates its schema
# on first boot; use a managed database backup policy before deploying.
DATABASE_URL=postgresql://user:password@host:5432/deepintelligence
# Redis is required when APP_ENV=production so rate limits apply to every worker.
REDIS_URL=redis://user:password@host:6379/0

GAPGPT_API_KEY=replace-with-your-gapgpt-key
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
GAPGPT_MODEL=gpt-5.1-codex-mini
GAPGPT_MAX_OUTPUT_TOKENS=12000

# The active provider is stored in the database after an admin changes it.
# This value is used only until a database selection exists.
AI_PROVIDER_DEFAULT=gapgpt
AVALAI_API_KEY=replace-with-your-avalai-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_TEST_MODEL=gpt-4o-mini-search-preview
AVALAI_MAX_OUTPUT_TOKENS=12000
MAX_SKILL_CONTEXT_CHARS=60000
# Maximum JSON body accepted by each protected analysis endpoint.
MAX_ANALYSIS_BODY_BYTES=5000000
# Maximum uploaded CSV/Excel/SPSS/Stata/SAS file size for one analysis import.
MAX_ANALYSIS_UPLOAD_BYTES=5000000

ADMIN_EMAIL=admin@example.com
# Prefer this in every shared or production environment. Generate with:
# python -c "import main; print(main.hash_password('your-password'))"
ADMIN_PASSWORD_HASH=pbkdf2_sha256$200000$replace-with-salt$replace-with-hash
# Local-only fallback. Do not use ADMIN_PASSWORD in production.
ADMIN_PASSWORD=
ADMIN_NAME=Admin

ZARINPAL_MERCHANT_ID=replace-with-your-merchant-id
ZARINPAL_ACCESS_TOKEN=replace-with-your-access-token-for-refunds-if-needed
# true = test gateway, false = real Zarinpal payment gateway
ZARINPAL_SANDBOX=false
ZARINPAL_CURRENCY=IRT
