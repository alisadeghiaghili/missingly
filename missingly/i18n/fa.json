    "mcar_low": "\u062a\u062d\u0644\u06cc\u0644 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u06a9\u0627\u0645\u0644 \u06cc\u0627 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646/\u0645\u06cc\u0627\u0646\u0647",
    "mcar_low_detail": "\u063a\u06cc\u0628\u0648\u062f MCAR \u0648 \u06a9\u0645 (< 5%) \u0627\u0633\u062a. \u062d\u0630\u0641 \u0633\u0637\u0631\u0647\u0627 \u06cc\u0627 \u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646/\u0645\u06cc\u0627\u0646\u0647 \u062e\u0637\u0627\u06cc \u0645\u0639\u0646\u06cc\u200c\u062f\u0627\u0631\u06cc \u0627\u06cc\u062c\u0627\u062f \u0646\u0645\u06cc\u200c\u06a9\u0646\u062f.",
    "mcar_moderate": "\u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc KNN \u06cc\u0627 MICE",
    "mcar_moderate_detail": "\u063a\u06cc\u0628\u0648\u062f MCAR \u0627\u0645\u0627 \u0645\u062a\u0648\u0633\u0637 (5\u201320%) \u0627\u0633\u062a. KNN \u06cc\u0627 MICE \u0633\u0627\u062e\u062a\u0627\u0631 \u0622\u0645\u0627\u0631\u06cc \u0628\u06cc\u0634\u062a\u0631\u06cc \u0646\u0633\u0628\u062a \u0628\u0647 \u0645\u06cc\u0627\u0646\u06af\u06cc\u0646/\u0645\u06cc\u0627\u0646\u0647 \u062d\u0641\u0638 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f.",
    "mcar_high": "\u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc MICE + \u062a\u062d\u0644\u06cc\u0644 \u062d\u0633\u0627\u0633\u06cc\u062a",
    "mcar_high_detail": "\u063a\u06cc\u0628\u0648\u062f MCAR \u0627\u0645\u0627 \u0632\u06cc\u0627\u062f (\u2265 20%) \u0627\u0633\u062a. \u0627\u0632 MICE \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f \u0648 \u062a\u062d\u0644\u06cc\u0644 \u062d\u0633\u0627\u0633\u06cc\u062a \u0627\u0646\u062c\u0627\u0645 \u062f\u0647\u06cc\u062f.",
    "not_mcar_moderate": "\u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc MICE \u06cc\u0627 Random Forest",
    "not_mcar_moderate_detail": "\u063a\u06cc\u0628\u0648\u062f MCAR \u0646\u06cc\u0633\u062a. \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u0645\u0628\u062a\u0646\u06cc \u0628\u0631 \u0645\u062f\u0644 (MICE\u060c RF\u060c GB) \u062a\u0648\u0635\u06cc\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f.",
    "not_mcar_high": "\u062c\u0627\u06cc\u06af\u0632\u06cc\u0646\u06cc Random Forest \u06cc\u0627 Gradient Boosting + \u0628\u0631\u0631\u0633\u06cc \u062f\u0627\u0645\u0646\u0647",
